{
  "name": "karin-plugin-drawimages",
  "version": "1.0.4",
  "author": "huayunduan",
  "type": "module",
  "description": "Karin AI drawing plugin for #draw, supporting text-to-image and image-to-image with Images API, Chat Completions, and Responses backends",
  "homepage": "https://github.com/Chenyuxin221/karin-plugin-drawImage",
  "bugs": {
    "url": "https://github.com/Chenyuxin221/karin-plugin-drawImage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chenyuxin221/karin-plugin-drawImage.git"
  },
  "keywords": [
    "karin",
    "karin-plugin",
    "draw",
    "image-generation",
    "text-to-image",
    "image-to-image",
    "openai-images",
    "chat-completions",
    "responses-api"
  ],
  "scripts": {
    "app": "node lib/src/app.js",
    "build": "tsup && vite build",
    "dev": "cross-env EBV_FILE=\"development.env\" node --import tsx src/app.ts",
    "lint": "eslint src test web.config.ts vite.config.ts web/src",
    "test": "node --import tsx --import ./test/setup.ts --test --test-force-exit --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit --skipLibCheck && tsc -p web/tsconfig.json --noEmit",
    "web:dev": "vite",
    "web:preview": "vite preview",
    "pub": "npm publish --access public"
  },
  "main": "lib/src/index.js",
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20.17.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.7.0",
    "lucide-react": "^0.545.0",
    "neostandard": "^0.11.9",
    "node-karin": "^1.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "vite": "^7.3.1"
  },
  "karin": {
    "main": "lib/src/index.js",
    "web": "lib/web.config.js",
    "ts-web": "web.config.ts",
    "apps": [
      "lib/src/apps"
    ],
    "ts-apps": [
      "src/apps"
    ],
    "static": [
      "resources"
    ],
    "files": [
      "config",
      "data",
      "resources"
    ]
  },
  "files": [
    "/lib/**/*.js",
    "/lib/web/**",
    "resources",
    "!lib/app.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "eventsource-parser": "^3.0.8"
  },
  "peerDependencies": {
    "node-karin": "^1.16.3"
  },
  "peerDependenciesMeta": {
    "node-karin": {
      "optional": true
    }
  }
}